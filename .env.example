# ---------------------------------------------------------------------------------------------------
# XploAds environment. Copy to .env and change every value marked CHANGE ME. Never commit .env.
# Full reference: docs/deployment/ENVIRONMENT.md
# ---------------------------------------------------------------------------------------------------

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# host port for Nginx in local compose
HTTP_PORT=8080

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=xploads
POSTGRES_SUPERUSER=postgres
# CHANGE ME
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# CHANGE ME  (migrations role)
XPLOADS_OWNER_PASSWORD=change-me-owner
# CHANGE ME  (runtime role, NOBYPASSRLS)
XPLOADS_APP_PASSWORD=change-me-app
# DATABASE_URL / MIGRATION_DATABASE_URL / REDIS_URL are composed in docker-compose.yml.
# For running the API outside Docker set them explicitly, e.g.:
# DATABASE_URL=postgresql+asyncpg://xploads_app:change-me-app@localhost:5432/xploads
# MIGRATION_DATABASE_URL=postgresql+psycopg://xploads_owner:change-me-owner@localhost:5432/xploads
# REDIS_URL=redis://localhost:6379/0

# --- Auth & secrets ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# CHANGE ME (>= 32 chars)
JWT_SECRET=change-me-generate-a-long-random-secret-value
# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# CHANGE ME (32-byte key, base64url). Keep outside the DB.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true whenever served over HTTPS (required in staging/production)
COOKIE_SECURE=false

# --- URLs ---
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Object storage (brand assets) ---
# docker compose runs SeaweedFS (S3-compatible) and sets STORAGE_BACKEND=s3 and S3_ENDPOINT_URL itself.
# Outside Docker, STORAGE_BACKEND=local keeps files in STORAGE_LOCAL_PATH (development only).
STORAGE_BUCKET=xploads-assets
# CHANGE ME  (also used to create the local storage service's credentials)
S3_ACCESS_KEY_ID=xploads
# CHANGE ME
S3_SECRET_ACCESS_KEY=change-me-storage-secret
S3_REGION=us-east-1
# URL the browser uses for signed upload/download links. Local compose: the storage port on this machine.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
STORAGE_PORT=8333
# For AWS S3 / Cloudflare R2 in production, set S3_ENDPOINT_URL (R2: https://<account>.r2.cloudflarestorage.com),
# S3_PUBLIC_ENDPOINT_URL to the same value, and configure bucket CORS (docs/deployment/DEPLOYMENT.md).

# --- Email ---
# console (logs emails; local only) | smtp
EMAIL_MODE=console
EMAIL_FROM=XploAds <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Observability ---
SENTRY_DSN=
RATE_LIMIT_ENABLED=true
